{
  "widgets": [
    {
      "title": "CLG2026 パーソナライズ診断",
      "description": "5つの質問に答えると「顧客成長タイプ」とおすすめのCLG2026セッションを診断するウィジェット",
      "category": "Custom",
      "source": {
        "path": "widgets/clg2026-quiz/dist",
        "entry": "content.html"
      },
      "type": "clg2026-quiz"
    }
  ],
  "stylesheets": [
    {
      "rules": [
        {
          "field": "pageType",
          "operator": "in",
          "value": [
            "global"
          ]
        }
      ],
      "name": "theme",
      "description": "Shared design tokens and component styles",
      "path": "./stylesheets/theme/style.css"
    }
  ],
  "scripts": [
    {
      "rules": [
        {
          "field": "pageType",
          "operator": "in",
          "value": [
            "global"
          ]
        }
      ],
      "placement": "head",
      "name": "analytics",
      "description": "Tracks widget impressions and interactions",
      "path": "./scripts/analytics/script.js"
    }
  ]
}
