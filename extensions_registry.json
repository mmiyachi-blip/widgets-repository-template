{
  "widgets": [
    {
      "title": "CLG2026 パーソナライズ診断",
      "description": "5つの質問に答えると「顧客成長タイプ」とおすすめのCLG2026セッションを診断するウィジェット",
      "category": "Custom",
      "source": {
        "path": "widgets/clg2026-quiz/dist",
        "entry": "content.html"
      },
      "type": "clg2026-quiz"
    },
    {
      "title": "CLG2026 パーソナライズ診断(シェア機能付き)",
      "description": "5つの質問に答えると「今のあなたの挑戦テーマ」とおすすめのCLG2026セッションを診断し、結果を画像保存・X投稿・メールでシェアできるウィジェット",
      "category": "Custom",
      "source": {
        "path": "widgets/clg2026-quiz-share/dist",
        "entry": "content.html"
      },
      "type": "clg2026-quiz-share"
    },
    {
      "title": "Monday CL Dashboard (CS CTA)",
      "description": "月曜朝会用のCL管理ダッシュボード。会社の状況を見ながらCTAの新規作成・クローズをワンクリックでGainsight CSに反映します。",
      "category": "Custom",
      "source": {
        "path": "widgets/monday-cl-dashboard/dist",
        "entry": "content.html"
      },
      "configuration": {
        "properties": [
          {
            "name": "company_id",
            "type": "text",
            "label": "対象会社のGSID (Company.Gsid)",
            "description": "Gainsight CSのCompanyオブジェクトのGsid",
            "defaultValue": "1P02590SW1W5U59W3MAP362TEYO6Z2O9R3ZL",
            "rules": {
              "required": true,
              "minLength": 20,
              "maxLength": 60
            }
          },
          {
            "name": "company_name",
            "type": "text",
            "label": "対象会社の表示名",
            "defaultValue": "test_miya田中テック株式会社（親）",
            "rules": {
              "required": true,
              "maxLength": 160
            }
          },
          {
            "name": "csm_name",
            "type": "text",
            "label": "CSM表示名（任意）",
            "defaultValue": "Minori Miyachi",
            "rules": {
              "maxLength": 120
            }
          },
          {
            "name": "type_id",
            "type": "text",
            "label": "CTAタイプのGSID（既定: 目標）",
            "description": "manage_cockpit_actions(mode=prepare_cta)で取得したTypeのGsid",
            "defaultValue": "1I00650WACZ7F0X9HRI49M5BV79HFLJ9KRUM",
            "rules": {
              "required": true,
              "minLength": 20,
              "maxLength": 60
            }
          },
          {
            "name": "owner_id",
            "type": "text",
            "label": "CTA作成時の担当者GSID (gsuser.Gsid)",
            "defaultValue": "1P0143F587OQLBLSRMAE2WKOVL4KS625K12T",
            "rules": {
              "required": true,
              "minLength": 20,
              "maxLength": 60
            }
          }
        ]
      },
      "defaultConfig": {
        "company_id": "1P02590SW1W5U59W3MAP362TEYO6Z2O9R3ZL",
        "company_name": "test_miya田中テック株式会社（親）",
        "csm_name": "Minori Miyachi",
        "type_id": "1I00650WACZ7F0X9HRI49M5BV79HFLJ9KRUM",
        "owner_id": "1P0143F587OQLBLSRMAE2WKOVL4KS625K12T"
      },
      "type": "monday-cl-dashboard"
    }
  ],
  "stylesheets": [
    {
      "rules": [
        {
          "field": "pageType",
          "operator": "in",
          "value": [
            "global"
          ]
        }
      ],
      "name": "theme",
      "description": "Shared design tokens and component styles",
      "path": "./stylesheets/theme/style.css"
    }
  ],
  "scripts": [
    {
      "rules": [
        {
          "field": "pageType",
          "operator": "in",
          "value": [
            "global"
          ]
        }
      ],
      "placement": "head",
      "name": "analytics",
      "description": "Tracks widget impressions and interactions",
      "path": "./scripts/analytics/script.js"
    }
  ]
}
