{
  "connectors": [
    {
      "name": "Google Calendar Events",
      "permalink": "gcal-events",
      "url": "https://www.googleapis.com/calendar/v3/calendars/{{ get_variable('gcal_calendar_id') }}/events",
      "method": "GET",
      "query_parameters": [
        {
          "key": "singleEvents",
          "value": "true",
          "overridable": false
        },
        {
          "key": "orderBy",
          "value": "startTime",
          "overridable": false
        },
        {
          "key": "timeMin",
          "value": "2020-01-01T00:00:00Z",
          "overridable": true
        },
        {
          "key": "timeMax",
          "value": "2030-01-01T00:00:00Z",
          "overridable": true
        },
        {
          "key": "maxResults",
          "value": "250",
          "overridable": true
        }
      ],
      "authentication": {
        "type": "oauth_jwt_bearer",
        "config": {
          "client_id": "{{ get_secret('gcal_service_account_email') }}",
          "private_key": "{{ get_secret('gcal_service_account_private_key') }}",
          "token_url": "https://oauth2.googleapis.com/token",
          "subject": "{{ get_secret('gcal_service_account_email') }}",
          "audience": "https://oauth2.googleapis.com/token",
          "algorithm": "RS256",
          "token_ttl": 3600,
          "additional_claims": {
            "scope": "https://www.googleapis.com/auth/calendar.readonly"
          }
        }
      },
      "response_body": "{% if response.status_code >= 400 %}\n{{ response.body }}\n{% else %}\n{% set data = response.body | from_json %}\n{% set ns = namespace(out=[]) %}\n{% for item in data['items'] %}\n{% set is_all_day = 'date' in item['start'] %}\n{% set start_date = item['start']['date'] if is_all_day else item['start']['dateTime'][:10] %}\n{% set start_time = '' if is_all_day else item['start']['dateTime'][11:16] %}\n{% set end_time = '' if is_all_day else item['end']['dateTime'][11:16] %}\n{% set ns.out = ns.out + [{\"id\": item['id'], \"title\": item['summary'] | default('(無題)'), \"date\": start_date, \"time\": start_time, \"endTime\": end_time, \"description\": item['description'] | default(''), \"url\": item['htmlLink'] | default(''), \"colorId\": item['colorId'] | default(''), \"isAllDay\": is_all_day, \"startDateTime\": item['start']['dateTime'] | default(''), \"endDateTime\": item['end']['dateTime'] | default(''), \"endDate\": item['end']['date'] | default('')}] %}\n{% endfor %}\n{{ ns.out | json_encode }}\n{% endif %}",
      "response_content_type": "application/json"
    },
    {
      "name": "CC Latest Topics by Category",
      "permalink": "cc-latest-topics",
      "url": "https://api2-us-west-2.insided.com/v2/topics",
      "method": "GET",
      "headers": [
        {
          "key": "Accept",
          "value": "application/json",
          "overridable": false
        }
      ],
      "query_parameters": [
        {
          "key": "categoryId",
          "value": "",
          "overridable": true
        },
        {
          "key": "tags",
          "value": "",
          "overridable": true
        },
        {
          "key": "sort",
          "value": "createdAt",
          "overridable": false
        },
        {
          "key": "pageSize",
          "value": "5",
          "overridable": true
        },
        {
          "key": "page",
          "value": "1",
          "overridable": false
        }
      ],
      "authentication": {
        "type": "oauth_client_credentials",
        "config": {
          "client_id": "{{ get_secret('cc_api_client_id') }}",
          "client_secret": "{{ get_secret('cc_api_client_secret') }}",
          "token_url": "https://api2-us-west-2.insided.com/oauth2/token",
          "scope": "read"
        }
      },
      "response_content_type": "application/json"
    },
    {
      "name": "CC Topics by Category and Tag",
      "permalink": "cc-category-topics",
      "url": "https://api2-us-west-2.insided.com/v2/topics",
      "method": "GET",
      "headers": [
        {
          "key": "Accept",
          "value": "application/json",
          "overridable": false
        }
      ],
      "query_parameters": [
        {
          "key": "categoryId",
          "value": "427",
          "overridable": true
        },
        {
          "key": "tags",
          "value": "次回開催",
          "overridable": true
        },
        {
          "key": "sort",
          "value": "createdAt",
          "overridable": false
        },
        {
          "key": "pageSize",
          "value": "25",
          "overridable": true
        },
        {
          "key": "page",
          "value": "1",
          "overridable": true
        }
      ],
      "authentication": {
        "type": "oauth_client_credentials",
        "config": {
          "client_id": "{{ get_secret('cc_api_client_id') }}",
          "client_secret": "{{ get_secret('cc_api_client_secret') }}",
          "token_url": "https://api2-us-west-2.insided.com/oauth2/token",
          "scope": "read"
        }
      },
      "response_content_type": "application/json"
    },
    {
      "name": "CC Recent Topics (all categories)",
      "permalink": "cc-recent-topics",
      "url": "https://api2-us-west-2.insided.com/v2/topics",
      "method": "GET",
      "headers": [
        {
          "key": "Accept",
          "value": "application/json",
          "overridable": false
        }
      ],
      "query_parameters": [
        {
          "key": "sort",
          "value": "createdAt",
          "overridable": false
        },
        {
          "key": "pageSize",
          "value": "100",
          "overridable": false
        },
        {
          "key": "page",
          "value": "1",
          "overridable": false
        }
      ],
      "authentication": {
        "type": "oauth_client_credentials",
        "config": {
          "client_id": "{{ get_secret('cc_api_client_id') }}",
          "client_secret": "{{ get_secret('cc_api_client_secret') }}",
          "token_url": "https://api2-us-west-2.insided.com/oauth2/token",
          "scope": "read"
        }
      },
      "response_body": "{% if response.status_code >= 400 %}\n{{ response.body }}\n{% else %}\n{% set data = response.body | from_json %}\n{% set ns = namespace(out=[]) %}\n{% for t in data['result'] %}\n{% set ns.out = ns.out + [{\"id\": t['id'], \"publicId\": t['publicId'], \"title\": t['title'], \"categoryId\": t['categoryId'] | default(''), \"categoryName\": t['categoryName'] | default(''), \"tags\": t['tags'] | default([]), \"createdAt\": t['createdAt'], \"status\": t['status'] | default(''), \"trashed\": t['trashed'] | default(false)}] %}\n{% endfor %}\n{{ ns.out | json_encode }}\n{% endif %}",
      "response_content_type": "application/json"
    },
    {
      "name": "Hackathon Articles List",
      "permalink": "hk-articles-list",
      "url": "https://api2-us-west-2.insided.com/v2/categories/{{ get_variable('hk_category_id') }}/articles",
      "method": "GET",
      "headers": [
        {
          "key": "Accept",
          "value": "application/json",
          "overridable": false
        }
      ],
      "query_parameters": [
        {
          "key": "pageSize",
          "value": "100",
          "overridable": false
        },
        {
          "key": "page",
          "value": "1",
          "overridable": true
        }
      ],
      "authentication": {
        "type": "oauth_client_credentials",
        "config": {
          "client_id": "{{ get_secret('cc_api_client_id') }}",
          "client_secret": "{{ get_secret('cc_api_client_secret') }}",
          "token_url": "https://api2-us-west-2.insided.com/oauth2/token",
          "scope": "read"
        }
      },
      "response_body": "{% if response.status_code >= 400 %}\n{{ response.body }}\n{% else %}\n{% set data = response.body | from_json %}\n{% set me = (user.id | default('')) | string %}\n{% set ns = namespace(out=[]) %}\n{% for a in data['result'] %}\n{% if ('hackathon' in (a['tags'] | default([]))) and not (a['trashed'] | default(false)) %}\n{% set likers = (a['likedBy'] | default(a['likeSet'] | default([]))) | map('string') | list %}\n{% set ns.out = ns.out + [{\"id\": a['id'], \"title\": a['title'], \"body\": (a['body'] or a['content'] or ''), \"_keys\": (a.keys() | list), \"tags\": a['tags'], \"author\": (a['author']['username'] | default('')), \"publishedAt\": a['publishedAt'] | default(a['createdAt']), \"url\": a['seoCommunityUrl'] | default(''), \"likes\": likers | length, \"liked\": (me != '' and me in likers), \"replies\": a['replyCount'] | default(0)}] %}\n{% endif %}\n{% endfor %}\n{{ ns.out | json_encode }}\n{% endif %}",
      "response_content_type": "application/json"
    },
    {
      "name": "Hackathon Article Create",
      "permalink": "hk-article-create",
      "url": "https://api2-us-west-2.insided.com/v2/articles/create",
      "method": "POST",
      "headers": [
        {
          "key": "Accept",
          "value": "application/json",
          "overridable": false
        },
        {
          "key": "Content-Type",
          "value": "application/json",
          "overridable": false
        }
      ],
      "query_parameters": [
        {
          "key": "authorId",
          "value": "{{ user.id }}",
          "overridable": false
        },
        {
          "key": "moderatorId",
          "value": "{{ get_variable('hk_moderator_id') }}",
          "overridable": false
        }
      ],
      "authentication": {
        "type": "oauth_client_credentials",
        "config": {
          "client_id": "{{ get_secret('cc_api_client_id') }}",
          "client_secret": "{{ get_secret('cc_api_client_secret') }}",
          "token_url": "https://api2-us-west-2.insided.com/oauth2/token",
          "scope": "read write"
        }
      },
      "request_body": "{% set p = body_text | from_json %}\n{\n  \"title\": {{ p.title | tojson }},\n  \"content\": {{ p.content | tojson }},\n  \"categoryId\": 427,\n  \"tags\": {{ (['hackathon'] + (p.tags | default([]))) | tojson }}\n}",
      "response_content_type": "application/json"
    },
    {
      "name": "Hackathon Article Like",
      "permalink": "hk-article-like",
      "url": "https://api2-us-west-2.insided.com/v2/articles/{{ pathParams.id }}/like",
      "method": "POST",
      "headers": [
        {
          "key": "Accept",
          "value": "application/json",
          "overridable": false
        }
      ],
      "query_parameters": [
        {
          "key": "likedBy",
          "value": "{{ user.id }}",
          "overridable": false
        }
      ],
      "path_parameters": [
        {
          "key": "id"
        }
      ],
      "authentication": {
        "type": "oauth_client_credentials",
        "config": {
          "client_id": "{{ get_secret('cc_api_client_id') }}",
          "client_secret": "{{ get_secret('cc_api_client_secret') }}",
          "token_url": "https://api2-us-west-2.insided.com/oauth2/token",
          "scope": "read write"
        }
      }
    },
    {
      "name": "Hackathon Article Unlike",
      "permalink": "hk-article-unlike",
      "url": "https://api2-us-west-2.insided.com/v2/articles/{{ pathParams.id }}/unlike",
      "method": "POST",
      "headers": [
        {
          "key": "Accept",
          "value": "application/json",
          "overridable": false
        }
      ],
      "query_parameters": [
        {
          "key": "unlikedBy",
          "value": "{{ user.id }}",
          "overridable": false
        }
      ],
      "path_parameters": [
        {
          "key": "id"
        }
      ],
      "authentication": {
        "type": "oauth_client_credentials",
        "config": {
          "client_id": "{{ get_secret('cc_api_client_id') }}",
          "client_secret": "{{ get_secret('cc_api_client_secret') }}",
          "token_url": "https://api2-us-west-2.insided.com/oauth2/token",
          "scope": "read write"
        }
      }
    }
  ]
}
