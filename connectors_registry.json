          "request_body": "{% set p = request.body_text | from_json %}{% set args = {'mode': 'create_cta', 'name': p.cta_name, 'company_id': p.company_id, 'type_id': p.type_id, 'status_id': p.status_id, 'priority_id': p.priority_id, 'reason_id': p.reason_id, 'owner_id': p.owner_id, 'due_date': p.due_date, 'description': p.description | default(''), 'originating_user_query': 'Created via Monday CL Dashboard (Gainsight CC widget).'} %}{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"manage_cockpit_actions\",\"arguments\":{{ args | tojson }}}}"
        }
