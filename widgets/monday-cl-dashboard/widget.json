{
  "title": "Monday CL Dashboard (CS CTA)",
  "description": "月曜朝会用のCL管理ダッシュボード。会社の状況を見ながらCTAの新規作成・クローズをワンクリックでGainsight CSに反映します。",
  "category": "Custom",
  "source": {
    "path": "dist",
    "entry": "content.html"
  },
  "configuration": {
    "properties": [
      {
        "name": "company_id",
        "type": "text",
        "label": "対象会社のGSID (Company.Gsid)",
        "description": "Gainsight CSのCompanyオブジェクトのGsid",
        "defaultValue": "1P02590SW1W5U59W3MAP362TEYO6Z2O9R3ZL",
        "rules": {
          "required": true,
          "minLength": 20,
          "maxLength": 60
        }
      },
      {
        "name": "company_name",
        "type": "text",
        "label": "対象会社の表示名",
        "defaultValue": "test_miya田中テック株式会社（親）",
        "rules": {
          "required": true,
          "maxLength": 160
        }
      },
      {
        "name": "csm_name",
        "type": "text",
        "label": "CSM表示名（任意）",
        "defaultValue": "Minori Miyachi",
        "rules": {
          "maxLength": 120
        }
      },
      {
        "name": "type_id",
        "type": "text",
        "label": "CTAタイプのGSID（既定: 目標）",
        "description": "manage_cockpit_actions(mode=prepare_cta)で取得したTypeのGsid",
        "defaultValue": "1I00650WACZ7F0X9HRI49M5BV79HFLJ9KRUM",
        "rules": {
          "required": true,
          "minLength": 20,
          "maxLength": 60
        }
      },
      {
        "name": "owner_id",
        "type": "text",
        "label": "CTA作成時の担当者GSID (gsuser.Gsid)",
        "defaultValue": "1P0143F587OQLBLSRMAE2WKOVL4KS625K12T",
        "rules": {
          "required": true,
          "minLength": 20,
          "maxLength": 60
        }
      }
    ]
  },
  "defaultConfig": {
    "company_id": "1P02590SW1W5U59W3MAP362TEYO6Z2O9R3ZL",
    "company_name": "test_miya田中テック株式会社（親）",
    "csm_name": "Minori Miyachi",
    "type_id": "1I00650WACZ7F0X9HRI49M5BV79HFLJ9KRUM",
    "owner_id": "1P0143F587OQLBLSRMAE2WKOVL4KS625K12T"
  }
}