{
  "connectors": [
    {
      "name": "CC Topics by Category and Tag",
      "permalink": "cc-category-topics",
      "url": "https://api2-us-west-2.insided.com/topics",
      "method": "GET",
      "query_parameters": [
        { "key": "categoryId", "overridable": true },
        { "key": "tags", "overridable": true },
        { "key": "sort", "value": "createdAt", "overridable": false },
        { "key": "pageSize", "overridable": true },
        { "key": "page", "value": "1", "overridable": true }
      ],
      "authentication": {
        "type": "oauth_client_credentials",
        "config": {
          "client_id": "{{ get_secret('cc_api_client_id_jp') }}",
          "client_secret": "{{ get_secret('cc_api_client_secret_jp') }}",
          "token_url": "https://api2-us-west-2.insided.com/oauth2/token",
          "scope": "read"
        }
      },
      "response_content_type": "application/json"
    }
  ]
}
